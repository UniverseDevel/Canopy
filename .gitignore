# Never commit the pseudonym mapping used for sanitizing test data
testing/.redaction-map.local.yaml
testing/**/*.local.*

# Containerlab runtime folders
lab/clab-*/
lab/.*.clab.yml.bak

# Build output
/bin/
/dist/

# IDE
.idea/
web/node_modules/

# Downloaded YANG models for local testing
lab/models/

# Lab CA exported by lab/operator/lab.sh
lab/.tls/
# Lab SSH key created by lab/operator/lab.sh jumphost
lab/.ssh/
# Kind kubeconfig written by lab/operator/lab.sh kubeconfig
lab/.kube/

# Encrypted device passwords (canopy conn password --store file)
*.secrets.yaml
/lab/connections.yaml
