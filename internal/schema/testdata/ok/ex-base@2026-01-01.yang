module ex-base {
  yang-version 1.1;
  namespace "urn:example:base";
  prefix exb;

  organization "Example";
  revision 2026-01-01 { description "Initial."; }

  typedef admin-state { type enumeration { enum enable; enum disable; } }

  container system {
    leaf hostname { type string { length "1..63"; } description "Host name."; }
    container information {
      config false;
      leaf version { type string; description "Software version."; }
    }
  }
  list interface {
    key "name";
    leaf name { type string; }
    leaf admin-state { type admin-state; default enable; }
    leaf mtu { type uint16 { range "1500..9500"; } units bytes; }
    choice mode {
      case routed { leaf ip { type string; } }
      case bridged { leaf vlan { type uint16; } }
    }
    container statistics {
      config false;
      leaf in-octets { type uint64; }
    }
  }
}
